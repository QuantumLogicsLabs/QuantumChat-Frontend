VITE_API_URL=http://localhost:5000
VITE_AI_API_URL=http://localhost:5001/api/v1

# Always-on signaling bot (see calling-bot/) used for real-time call/meeting
# signaling and presence. Must be wss:/https: in production (CSP requires it).
# Leave unset to fall back to REST polling only, same as before this existed.
VITE_SIGNAL_URL=

# TURN relay — required for calls between restrictive NAT/firewall networks
# (e.g. two different mobile carriers). Without it those calls fail outright:
# STUN alone can't find a path, and there's nowhere for the media to flow.
#
# Comma-separated so one provider can be reached over several ports. Include
# the TLS 443 entry — on locked-down corporate/hotel networks it's often the
# only one that gets through. Example (Metered free tier, 20GB/month):
#   VITE_TURN_URL=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
#
# A TURN relay only forwards DTLS-SRTP packets it cannot decrypt, so using a
# third-party provider does not weaken QuantumChat's end-to-end encryption.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
